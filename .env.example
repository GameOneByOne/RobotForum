NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudinary unsigned browser uploads for Markdown image hosting.
# Create an unsigned upload preset in Cloudinary, then fill these values.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Server-only. Use this only in trusted server routes/jobs, never in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
